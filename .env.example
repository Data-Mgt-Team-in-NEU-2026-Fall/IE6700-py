# Copy this file to .env and adjust it. The ie6700 commands read DATABASE_URL
# from .env (or from the environment, which takes precedence).
#
# Format: mysql://user:password@host:port/database
#   - only mysql:// is supported; the port defaults to 3306
#   - percent-encode special characters in the password (for example @ as %40)
#
# This default points at the local Docker sandbox started by ./mysql/reset.sh.
DATABASE_URL=mysql://root:ie6700_local_root@127.0.0.1:3307/seattle_marketplace
